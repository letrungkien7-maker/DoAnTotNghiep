# Application
APP_NAME="Real Estate API"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# Security & Authentication (Generate random secret in production)
SECRET_KEY="change_this_to_a_super_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://user:password@host:port/dbname
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="real_estate_db"
DATABASE_URL="postgresql+psycopg2://postgres:postgres_password@localhost:5432/real_estate_db"

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Cloudinary Media Storage (Optional at scaffold)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AI / LLM Configuration
LLM_PROVIDER="gemini" # or "openai", "ollama"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
