# ==============================================================================
# HỆ THỐNG KINH DOANH BẤT ĐỘNG SẢN TÍCH HỢP CHATBOT & GỢI Ý THÔNG MINH
# MÔI TRƯỜNG TRIỂN KHAI PRODUCTION (.env.production)
# ==============================================================================

# --- Application Server Configuration ---
APP_NAME="Real Estate Smart Platform API"
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# --- Security & JWT Authentication ---
# Sinh chuỗi bí mật an toàn ngẫu nhiên bằng lệnh: openssl rand -hex 32
SECRET_KEY=generate_a_random_32_bytes_hex_string_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- PostgreSQL Database Credentials ---
POSTGRES_USER=bds_admin
POSTGRES_PASSWORD=StrongPasswordForProduction123!
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=real_estate_production

# Hoặc chuỗi kết nối trực tiếp (nếu dùng Cloud Managed DB như AWS RDS/Supabase):
# DATABASE_URL=postgresql+psycopg2://bds_admin:StrongPasswordForProduction123!@postgres:5432/real_estate_production

# --- CORS Allowed Origins (Comma-separated) ---
CORS_ORIGINS=https://bds-smart.vn,https://www.bds-smart.vn,http://localhost,http://localhost:80

# --- AI & LLM Service Providers (Tùy chọn cho Online LLM Function Calling) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Cloudinary Cloud Storage (Lưu trữ ảnh bất động sản) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend Build Arguments (Khi build Docker) ---
VITE_API_BASE_URL=
VITE_API_V1_PREFIX=/api/v1
